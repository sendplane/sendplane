# Keep the build context to what `go build ./cmd/...` actually needs: Go
# sources, go.mod/go.sum, and anything they embed. Everything else here only
# slows `docker build` down or risks leaking local state into the image.

.git/
.github/

# Deploy tooling is not part of the image; the Helm chart *deploys* it.
deploy/helm/
deploy/dev/docker-compose.yml

# Docs, ADRs, license/readmes: not needed to build a binary.
docs/
*.md
LICENSE

# Frontend workspace (Vue/Vite/pnpm): the web-build stage in
# deploy/dev/Dockerfile needs the sources to build web/apps/console/dist,
# which is then copied into cmd/sendplane/console/dist for the Go build
# stage to embed (ADR-0010). node_modules and every workspace's dist/ are
# excluded either way: rebuilt fresh in the image, never useful from the
# host.
node_modules/
**/node_modules/
**/dist/

# Local dev / editor / CI state.
.env*
!.env.example
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.memory/
.golangci.yml
.editorconfig

# Build/test artifacts that should never be baked into an image.
*.test
*.out
coverage.*
*.coverprofile
profile.cov
/dist/
/bin/
