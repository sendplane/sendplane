{
  "name": "@sendplane/api",
  "version": "0.1.0",
  "description": "Framework-agnostic typed client for the sendplane REST API, generated from api/openapi.yaml.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "gen": "openapi-typescript ../../../api/openapi.yaml --output src/schema.d.ts --root-types --alphabetize",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-typescript-helpers": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
