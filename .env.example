# Copy to .env and fill in as needed:
#   cp .env.example .env
#
# These two env var names are the project-wide convention for the
# storetest conformance suite (see docs/adr/0007-repository-conformance.md).
# DB conformance tests skip automatically when the matching var is unset,
# so you only need to set the ones for the backend(s) you're working on.
#
# Matches deploy/dev/docker-compose.yml (`make dev-up`).
SENDPLANE_TEST_POSTGRES_DSN=postgres://sendplane:sendplane@localhost:55441/sendplane?sslmode=disable
SENDPLANE_TEST_MONGO_URI=mongodb://localhost:55442
